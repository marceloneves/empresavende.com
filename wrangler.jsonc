{
  // Deploy: npx wrangler deploy  (site estático servido como Worker com assets)
  "name": "empresavende",
  "compatibility_date": "2026-09-26",
  // Só o domínio próprio (ligado no painel/API); sem URL *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
