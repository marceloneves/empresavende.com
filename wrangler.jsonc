{
  // Deploy: npx wrangler deploy  (site estático servido como Worker com assets)
  "name": "empresavende",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  // Só o domínio próprio (ligado no painel/API); sem URL *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  // Formulário de contato (e-mail pelo Resend; a chave fica no secret RESEND_API_KEY).
  "vars": {
    "EMAIL_FROM": "EmpresaVende <contato@empresavende.com>",
    "CONTATO_TO": "contato@empresavende.com"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // O Worker roda antes dos arquivos para poder redirecionar o www.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
